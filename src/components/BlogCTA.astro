---
import { BLOG_UI, type BlogLang } from "../i18n/blog";
import { APP_URL, DOCS_URL } from "../i18n/copy";
import Logo from "./Logo.astro";
import Icon from "./Icon.astro";
interface Props { lang: BlogLang }
const { lang } = Astro.props;
const ui = BLOG_UI[lang];
---

<section class="bcta">
  <div class="bcta-box">
    <div class="bcta-logo"><Logo size={56} withText={false} /></div>
    <h2 class="bcta-title font-display">{ui.ctaTitle}</h2>
    <p class="bcta-text">{ui.ctaText}</p>
    <div class="bcta-btns">
      <a href={APP_URL} class="btn-cyan btn-pulse" target="_blank" rel="noopener"><Icon name="telegram" size={17} /> {ui.ctaPlay}</a>
      <a href={DOCS_URL} class="btn-secondary" target="_blank" rel="noopener"><Icon name="code" size={16} /> {ui.ctaDocs}</a>
    </div>
  </div>
</section>

<style>
  .bcta { padding: 30px 24px 10px; }
  .bcta-box {
    position: relative;
    max-width: 760px;
    margin: 0 auto;
    text-align: center;
    padding: 48px 28px;
    border-radius: 24px;
    overflow: hidden;
    background:
      radial-gradient(circle at 50% 0%, rgba(124, 92, 255, 0.16), transparent 60%),
      linear-gradient(180deg, var(--bg-2), var(--card));
    border: 1px solid var(--border);
  }
  .bcta-logo { display: flex; justify-content: center; margin-bottom: 14px; }
  .bcta-title { font-size: clamp(1.5rem, 4vw, 2.1rem); font-weight: 800; margin-bottom: 10px; }
  .bcta-text { color: var(--text-muted); font-size: 1.05rem; max-width: 480px; margin: 0 auto 26px; line-height: 1.7; }
  .bcta-btns { display: flex; gap: 14px; justify-content: center; flex-wrap: wrap; }
  @media (max-width: 480px) {
    .bcta { padding: 24px 16px 8px; }
    .bcta-box { padding: 36px 20px; border-radius: 18px; }
    .bcta-btns :global(.btn-cyan), .bcta-btns :global(.btn-secondary) { width: 100%; justify-content: center; }
  }
</style>
