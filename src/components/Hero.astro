---
/**
 * Bosh ekran.
 *
 * DIZAYN QARORI — nega markazlashtirilgan matn + pastda o'yin lentasi:
 * mijoz sahifaga «mening o'yinim bormi?» degan savol bilan keladi. Matnni
 * chapga, rasmni o'ngga qo'ysak, mobil ekranda muqovalar birinchi ekrandan
 * butunlay chiqib ketardi. Lenta esa telefonda ham darhol ko'rinadi va
 * savolga bir qarashda javob beradi.
 */
import { Image } from "astro:assets";
import Icon from "./Icon.astro";
import { t } from "../i18n/ui";
import { CATALOG } from "../data/games";
import { gameImage } from "../lib/gameImages";
import { ORG, botLinkFor, type Locale } from "../data/site";

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const c = t(locale);

// Lenta uzluksiz aylanishi uchun ro'yxat IKKI MARTA chiziladi: birinchi
// nusxa oxiriga yetganda ikkinchisi aynan o'sha joyda turadi, sakrash
// ko'rinmaydi.
const strip = [...CATALOG, ...CATALOG];
---

<section class="hero">
  <div class="wrap hero__in">
    <p class="chip hero__badge">
      <Icon name="gem" size={14} />
      {c.hero.badge}
    </p>

    <h1 class="hero__title">
      {c.hero.titleLead}{" "}
      <span class="grad">{c.hero.titleAccent}</span>
      {c.hero.titleTail && ` ${c.hero.titleTail}`}
    </h1>

    <p class="lede hero__lede">{c.hero.lede}</p>

    <div class="hero__actions">
      <a class="btn btn--primary btn--lg" href={botLinkFor()} target="_blank" rel="noopener">
        <Icon name="telegram" size={19} />
        {c.hero.ctaPrimary}
      </a>
      <a class="btn btn--lg btn--ghost" href="#oyinlar">
        {c.hero.ctaSecondary}
        <Icon name="chevron-down" size={17} />
      </a>
    </div>

    <div class="hero__pay">
      <span class="hero__pay-label">{c.hero.payLabel}</span>
      <ul class="hero__pay-list">
        {ORG.paymentMethods.map((m) => <li class="hero__pay-item">{m}</li>)}
      </ul>
    </div>

    <ul class="hero__stats">
      {
        c.hero.stats.map((s) => (
          <li class="hero__stat">
            <span class="hero__stat-v">{s.value}</span>
            <span class="hero__stat-l">{s.label}</span>
          </li>
        ))
      }
    </ul>
  </div>

  {/* O'yin lentasi — bezak, shuning uchun skrinriderdan yashirilgan.
      Xuddi shu o'yinlar pastdagi katalogda haqiqiy havola bo'lib turadi. */}
  <div class="marquee" aria-hidden="true">
    <div class="marquee__track">
      {
        strip.map((g) => {
          const img = gameImage(g.slug);
          return (
            <span class="marquee__item" style={`--a:${g.accent}`}>
              {img && (
                <Image
                  src={img}
                  alt=""
                  width={132}
                  height={132}
                  densities={[1, 2]}
                  loading="lazy"
                  class:list={["marquee__img", g.lightArtwork && "is-light"]}
                />
              )}
            </span>
          );
        })
      }
    </div>
  </div>
</section>

<style>
  .hero {
    position: relative;
    z-index: var(--z-body);
    padding-top: clamp(48px, 8vw, 96px);
    padding-bottom: clamp(40px, 6vw, 72px);
    overflow: hidden;
  }

  .hero__in {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    gap: var(--sp-5);
  }

  .hero__badge {
    /* Chip standart holatda matn rangida; bu yerda aksent bo'lsin */
    color: var(--text);
  }

  .hero__title {
    font-size: var(--t-hero);
    max-width: 16ch;
    /* Sarlavha juda katta bo'lgani uchun qator oralig'i qisqartiriladi,
       aks holda uch qator «uzilib» ketadi */
    line-height: 1.02;
  }

  .hero__lede {
    max-width: 56ch;
    text-align: center;
  }

  .hero__actions {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: var(--sp-3);
    margin-top: var(--sp-2);
  }

  /* ------------------------------------------------------------ to'lov -- */

  .hero__pay {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--sp-3);
    margin-top: var(--sp-3);
  }

  .hero__pay-label {
    font-size: var(--t-xs);
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--text-3);
  }

  .hero__pay-list {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: var(--sp-2);
    list-style: none;
  }

  /* To'lov tizimlari LOGO emas, so'z-yorliq sifatida beriladi: mavjud
     logolar to'plami to'liq emas (HUMO/Payme/Paynet yo'q), aralashtirish
     esa nomutanosib ko'rinardi. */
  .hero__pay-item {
    padding: 7px 15px;
    border-radius: var(--r-pill);
    border: 1px solid var(--line);
    background: var(--surface);
    font-size: var(--t-xs);
    font-weight: 700;
    letter-spacing: 0.01em;
    color: var(--text-2);
  }

  /* ------------------------------------------------------------ raqam --- */

  .hero__stats {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: clamp(20px, 5vw, 56px);
    margin-top: var(--sp-5);
    padding-top: var(--sp-5);
    border-top: 1px solid var(--line);
    list-style: none;
    width: min(100%, 620px);
  }

  .hero__stat {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 2px;
  }

  .hero__stat-v {
    font-family: var(--font-display);
    font-size: var(--t-xl);
    font-weight: 700;
    letter-spacing: -0.04em;
    background: var(--grad-brand);
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
  }

  .hero__stat-l {
    font-size: var(--t-xs);
    color: var(--text-3);
    text-align: center;
  }

  /* ----------------------------------------------------------- lenta ---- */

  .marquee {
    margin-top: clamp(40px, 7vw, 80px);
    /* Chekkalarda so'nadi — lenta ekrandan «kesilgandek» emas, davom
       etayotgandek ko'rinadi */
    -webkit-mask-image: linear-gradient(90deg, transparent, #000 9%, #000 91%, transparent);
    mask-image: linear-gradient(90deg, transparent, #000 9%, #000 91%, transparent);
  }

  .marquee__track {
    display: flex;
    gap: var(--sp-4);
    width: max-content;
  }

  @media (prefers-reduced-motion: no-preference) {
    .marquee__track {
      /* Ro'yxat ikki marta chizilgani uchun -50% aynan bir aylanish */
      animation: slide 46s linear infinite;
    }
    .marquee:hover .marquee__track {
      animation-play-state: paused;
    }
  }

  @keyframes slide {
    to {
      transform: translateX(-50%);
    }
  }

  .marquee__item {
    position: relative;
    display: block;
    width: 132px;
    height: 132px;
    border-radius: var(--r-lg);
    overflow: hidden;
    border: 1px solid var(--line);
    /* Har muqova o'z rangida nur beradi — lenta bir xil kulrang bo'lib
       qolmaydi */
    box-shadow:
      0 10px 34px -14px var(--a),
      inset 0 0 0 1px rgba(255, 255, 255, 0.05);
    flex: none;
  }

  .marquee__img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  /* Oq muqovalar (MLBB, Asphalt, Bigo, Steam) to'q fonda «suzib» qolmasin */
  .marquee__img.is-light {
    background: #fff;
    object-fit: contain;
    padding: 10px;
  }

  @media (max-width: 640px) {
    .marquee__item {
      width: 104px;
      height: 104px;
      border-radius: var(--r-md);
    }
  }
</style>
