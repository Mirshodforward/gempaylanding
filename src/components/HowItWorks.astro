---
/**
 * «Qanday ishlaydi» — to'rt qadam.
 *
 * Bu bo'lim `HowTo` JSON-LD bilan juftlashadi (sahifa o'zi yasaydi), shuning
 * uchun qadam matnlari sahifada AYNAN sxemadagidek ko'rinishi shart.
 */
import SectionHead from "./SectionHead.astro";
import Icon from "./Icon.astro";
import { t } from "../i18n/ui";
import type { Locale } from "../data/site";

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const c = t(locale);
---

<section class="section" id="qanday">
  <div class="wrap">
    <SectionHead eyebrow={c.how.eyebrow} title={c.how.title} lede={c.how.lede} />

    <ol class="steps">
      {
        c.how.steps.map((s, i) => (
          <li class="step rise" style={`--i:${i}`}>
            <span class="step__n">{i + 1}</span>
            <div class="step__txt">
              <h3 class="step__t">{s.title}</h3>
              <p class="step__d">{s.text}</p>
            </div>
          </li>
        ))
      }
    </ol>

    <p class="how-note">
      <Icon name="shield-check" size={17} />
      <span>{c.how.note}</span>
    </p>
  </div>
</section>

<style>
  .steps {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
    gap: clamp(16px, 2.4vw, 26px);
    list-style: none;
    counter-reset: step;
  }

  .step {
    position: relative;
    display: flex;
    flex-direction: column;
    gap: var(--sp-4);
    padding: clamp(20px, 2.6vw, 28px);
    border-radius: var(--r-lg);
    border: 1px solid var(--line);
    background: var(--surface);
  }

  /* Qadamlar orasidagi ulovchi chiziq — faqat keng ekranda, chunki bir
     ustunli joylashuvda u pastga emas, yon tomonga ketib qolardi. */
  @media (min-width: 1000px) {
    .step:not(:last-child)::after {
      content: "";
      position: absolute;
      top: 46px;
      inset-inline-end: calc(clamp(16px, 2.4vw, 26px) * -1);
      width: clamp(16px, 2.4vw, 26px);
      height: 1px;
      background: linear-gradient(90deg, var(--line-strong), transparent);
    }
  }

  .step__n {
    display: grid;
    place-items: center;
    width: 42px;
    height: 42px;
    flex: none;
    border-radius: var(--r-md);
    background: rgba(var(--accent-rgb), 0.13);
    border: 1px solid rgba(var(--accent-rgb), 0.3);
    font-family: var(--font-display);
    font-size: 1.05rem;
    font-weight: 700;
    color: var(--accent);
  }

  .step__t {
    font-size: var(--t-md);
    margin-bottom: 7px;
  }

  .step__d {
    font-size: var(--t-sm);
    color: var(--text-2);
    line-height: 1.65;
  }

  .how-note {
    display: flex;
    align-items: flex-start;
    gap: var(--sp-3);
    margin-top: clamp(20px, 3vw, 32px);
    padding: 16px 20px;
    border-radius: var(--r-md);
    background: rgba(52, 211, 153, 0.08);
    border: 1px solid rgba(52, 211, 153, 0.24);
    font-size: var(--t-sm);
    color: var(--text);
  }

  .how-note :global(svg) {
    flex: none;
    margin-top: 2px;
    color: var(--mint);
  }
</style>
