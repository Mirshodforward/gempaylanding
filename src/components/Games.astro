---
/** Katalog — 9 o'yin + Steam. Sahifadagi asosiy konversiya nuqtasi. */
import SectionHead from "./SectionHead.astro";
import GameCard from "./GameCard.astro";
import { CATALOG } from "../data/games";
import { t } from "../i18n/ui";
import type { Locale } from "../data/site";

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const c = t(locale);
---

<section class="section" id="oyinlar">
  <div class="wrap">
    <SectionHead eyebrow={c.games.eyebrow} title={c.games.title} lede={c.games.lede} center />

    <div class="ggrid">
      {
        CATALOG.map((g, i) => (
          <div class="rise" style={`--i:${i}`}>
            {/* Birinchi qator birinchi ekranda ko'rinishi mumkin — LCP
                nishoni bo'lgani uchun kechiktirilmaydi */}
            <GameCard game={g} locale={locale} index={i} eager={i < 5} />
          </div>
        ))
      }
    </div>
  </div>
</section>

<style>
  .ggrid {
    display: grid;
    /* `auto-fill` + `minmax` — media query'siz moslashadi: 360px da 2 ustun,
       planshetda 3-4, keng ekranda 5. Har bir sinish nuqtasini qo'lda
       yozishdan ko'ra ishonchliroq. */
    grid-template-columns: repeat(auto-fill, minmax(clamp(140px, 19vw, 196px), 1fr));
    gap: clamp(10px, 1.6vw, 18px);
  }
</style>
