---
/**
 * Futer.
 *
 * SEO roli: bu yerdagi o'yin havolalari SAYTNING HAR SAHIFASIDA turadi va
 * ichki havola og'irligini pul sahifalariga (`/oyinlar/*`) uzatadi. Shu
 * sabab ro'yxat qisqartirilmaydi — o'ntasi ham to'liq chiqadi.
 */
import Logo from "./Logo.astro";
import Icon from "./Icon.astro";
import { CATALOG } from "../data/games";
import { t } from "../i18n/ui";
import {
  localePath,
  botLinkFor,
  SUPPORT_URL,
  DOCS_URL,
  STARSPAYMEE_URL,
  ORG,
  type Locale,
} from "../data/site";

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const c = t(locale);
const year = new Date().getFullYear();
---

<footer class="ftr">
  <div class="wrap">
    <div class="ftr__top">
      <div class="ftr__brand">
        <Logo locale={locale} size={32} />
        <p class="ftr__tag">{c.footer.tagline}</p>
        <a class="btn ftr__bot" href={botLinkFor()} target="_blank" rel="noopener">
          <Icon name="telegram" size={17} />
          {c.nav.cta}
        </a>
      </div>

      <nav class="ftr__col" aria-labelledby="f-games">
        <h2 class="ftr__h" id="f-games">{c.footer.colGames}</h2>
        <ul class="ftr__list">
          {
            CATALOG.map((g) => (
              <li>
                <a class="ftr__link" href={localePath(locale, `oyinlar/${g.slug}`)}>
                  {g.title}
                </a>
              </li>
            ))
          }
        </ul>
      </nav>

      <nav class="ftr__col" aria-labelledby="f-co">
        <h2 class="ftr__h" id="f-co">{c.footer.colCompany}</h2>
        <ul class="ftr__list">
          <li><a class="ftr__link" href={localePath(locale, "blog")}>{c.footer.blog}</a></li>
          <li>
            <a class="ftr__link" href={STARSPAYMEE_URL} target="_blank" rel="noopener">
              {c.footer.ecosystem}
              <Icon name="external-link" size={13} />
            </a>
          </li>
          <li>
            <a class="ftr__link" href={DOCS_URL} target="_blank" rel="noopener">
              {c.footer.api}
              <Icon name="external-link" size={13} />
            </a>
          </li>
        </ul>
      </nav>

      <nav class="ftr__col" aria-labelledby="f-help">
        <h2 class="ftr__h" id="f-help">{c.footer.colHelp}</h2>
        <ul class="ftr__list">
          <li><a class="ftr__link" href={`${localePath(locale)}#faq`}>{c.nav.faq}</a></li>
          <li><a class="ftr__link" href={`${localePath(locale)}#qanday`}>{c.nav.how}</a></li>
          <li>
            <a class="ftr__link" href={SUPPORT_URL} target="_blank" rel="noopener">
              {c.footer.support}
              <Icon name="external-link" size={13} />
            </a>
          </li>
        </ul>
      </nav>
    </div>

    <div class="ftr__bot-bar">
      <p class="ftr__fine">© {year} {ORG.name}. {c.footer.rights}</p>
      {/* Savdo belgilari haqidagi izoh — o'yin nomlarini ishlatgan har qanday
          vositachi sayt uchun zarur huquqiy aniqlik */}
      <p class="ftr__fine ftr__disclaimer">{c.footer.disclaimer}</p>
    </div>
  </div>
</footer>

<style>
  .ftr {
    position: relative;
    z-index: var(--z-body);
    margin-top: var(--section-y);
    padding-block: clamp(40px, 5vw, 64px) var(--sp-6);
    border-top: 1px solid var(--line);
    background: linear-gradient(to bottom, transparent, rgba(var(--brand-rgb), 0.05));
  }

  .ftr__top {
    display: grid;
    gap: clamp(28px, 4vw, 48px);
    grid-template-columns: 1fr;
  }

  @media (min-width: 720px) {
    .ftr__top {
      grid-template-columns: 1.4fr repeat(3, minmax(0, 1fr));
    }
  }

  .ftr__brand {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: var(--sp-4);
    max-width: 34ch;
  }

  .ftr__tag {
    font-size: var(--t-sm);
    color: var(--text-2);
    line-height: 1.6;
  }

  .ftr__bot {
    padding: 11px 20px;
  }

  .ftr__h {
    font-family: var(--font-display);
    font-size: var(--t-xs);
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--text-3);
    margin-bottom: var(--sp-4);
  }

  .ftr__list {
    display: flex;
    flex-direction: column;
    gap: 9px;
    list-style: none;
  }

  .ftr__link {
    display: inline-flex;
    align-items: center;
    gap: 5px;
    font-size: var(--t-sm);
    color: var(--text-2);
    transition: color var(--dur-fast) var(--ease);
  }

  .ftr__link:hover {
    color: var(--accent);
  }

  .ftr__link :global(svg) {
    opacity: 0.5;
  }

  .ftr__bot-bar {
    display: flex;
    flex-direction: column;
    gap: var(--sp-2);
    margin-top: clamp(32px, 4vw, 52px);
    padding-top: var(--sp-5);
    border-top: 1px solid var(--line);
  }

  .ftr__fine {
    font-size: var(--t-xs);
    color: var(--text-3);
    line-height: 1.6;
  }

  .ftr__disclaimer {
    max-width: 78ch;
    opacity: 0.78;
  }
</style>
