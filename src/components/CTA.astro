---
/** Yakuniy chaqiriq — sahifa oxiridagi oxirgi konversiya imkoniyati. */
import Icon from "./Icon.astro";
import { botLinkFor, localePath, type Locale } from "../data/site";
import { t } from "../i18n/ui";

interface Props {
  locale: Locale;
  /** Sarlavhani almashtirish — o'yin sahifasida «PUBG hisobini to'ldiring» */
  title?: string;
  lede?: string;
  /** Botga o'tishda yuboriladigan o'yin kodi (atributsiya) */
  gameCode?: string;
}

const { locale, title, lede, gameCode } = Astro.props;
const c = t(locale);
---

<section class="section">
  <div class="wrap">
    <div class="cta">
      <h2 class="cta__title">{title ?? c.cta.title}</h2>
      <p class="lede cta__lede">{lede ?? c.cta.lede}</p>
      <div class="cta__actions">
        <a class="btn btn--primary btn--lg" href={botLinkFor(gameCode)} target="_blank" rel="noopener">
          <Icon name="telegram" size={19} />
          {c.cta.primary}
        </a>
        <a class="btn btn--lg btn--ghost" href={localePath(locale, "blog")}>
          <Icon name="book" size={17} />
          {c.cta.secondary}
        </a>
      </div>
    </div>
  </div>
</section>

<style>
  .cta {
    position: relative;
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    gap: var(--sp-4);
    padding: clamp(40px, 6vw, 76px) clamp(24px, 4vw, 56px);
    border-radius: var(--r-xl);
    overflow: hidden;
    border: 1px solid rgba(var(--accent-rgb), 0.26);
    background:
      radial-gradient(ellipse 90% 130% at 50% 0%, rgba(var(--accent-rgb), 0.24), transparent 66%),
      var(--surface);
  }

  /* Yuqori qirradagi yorug' chiziq — «gem-cut» tilining takrori */
  .cta::before {
    content: "";
    position: absolute;
    inset-inline: 18%;
    top: 0;
    height: 1px;
    background: linear-gradient(90deg, transparent, var(--accent), transparent);
  }

  .cta__title {
    max-width: 18ch;
  }

  .cta__lede {
    text-align: center;
    max-width: 52ch;
  }

  .cta__actions {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: var(--sp-3);
    margin-top: var(--sp-2);
  }
</style>
