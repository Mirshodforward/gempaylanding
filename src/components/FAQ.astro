---
/**
 * Savol-javob.
 *
 * `<details>` ishlatiladi, JS'siz akkordeon uchun emas — SEO uchun ham:
 * `<details>` ichidagi matn Googlebot uchun YOPIQ holatda ham to'liq
 * ko'rinadi va indekslanadi (JS bilan yashirilgan tarkifdan farqli).
 * Shu bois FAQPage sxemasi bilan mos keladi va «yashirin matn» jarimasi
 * yuzaga kelmaydi.
 */
import SectionHead from "./SectionHead.astro";
import Icon from "./Icon.astro";

interface Props {
  eyebrow: string;
  title: string;
  lede?: string;
  items: { q: string; a: string }[];
  id?: string;
}

const { eyebrow, title, lede, items, id = "faq" } = Astro.props;
---

<section class="section" id={id}>
  <div class="wrap">
    <SectionHead eyebrow={eyebrow} title={title} lede={lede} center />

    <div class="faq">
      {
        items.map((f, i) => (
          <details class="faq__i" name="faq" open={i === 0}>
            <summary class="faq__q">
              <span>{f.q}</span>
              <Icon name="chevron-down" size={19} />
            </summary>
            <div class="faq__a"><p>{f.a}</p></div>
          </details>
        ))
      }
    </div>
  </div>
</section>

<style>
  .faq {
    max-width: 800px;
    margin-inline: auto;
    display: flex;
    flex-direction: column;
    gap: var(--sp-2);
  }

  .faq__i {
    border-radius: var(--r-md);
    border: 1px solid var(--line);
    background: var(--surface);
    overflow: hidden;
    transition: border-color var(--dur-fast) var(--ease);
  }

  .faq__i[open] {
    border-color: rgba(var(--accent-rgb), 0.32);
    background: var(--surface-2);
  }

  .faq__q {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--sp-4);
    padding: 18px 20px;
    cursor: pointer;
    list-style: none;
    font-family: var(--font-display);
    font-size: var(--t-base);
    font-weight: 600;
    letter-spacing: -0.02em;
    line-height: 1.4;
  }

  .faq__q::-webkit-details-marker {
    display: none;
  }

  .faq__q :global(svg) {
    flex: none;
    color: var(--text-3);
    transition: transform var(--dur) var(--ease), color var(--dur) var(--ease);
  }

  .faq__i[open] .faq__q :global(svg) {
    transform: rotate(180deg);
    color: var(--accent);
  }

  .faq__a {
    padding: 0 20px 20px;
    font-size: var(--t-sm);
    color: var(--text-2);
    line-height: 1.7;
    max-width: 72ch;
  }
</style>
