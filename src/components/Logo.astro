---
/** GemPay belgisi + so'z-logo. Sarlavhada va futerda ishlatiladi. */
import { Image } from "astro:assets";
import mark from "../assets/brand/gempay-mark.png";
import { localePath, type Locale } from "../data/site";

interface Props {
  locale: Locale;
  size?: number;
  /** Faqat belgi — so'z-logosiz (kichik ekranlar uchun) */
  markOnly?: boolean;
  class?: string;
}

const { locale, size = 34, markOnly = false, class: cls = "" } = Astro.props;
const home = localePath(locale);
---

<a class:list={["logo", cls]} href={home} aria-label="GemPay — bosh sahifa">
  <Image
    src={mark}
    alt=""
    width={size * 1.47}
    height={size}
    densities={[1, 2]}
    loading="eager"
    class="logo__mark"
  />
  {!markOnly && <span class="logo__word">GemPay</span>}
</a>

<style>
  .logo {
    display: inline-flex;
    align-items: center;
    gap: 9px;
    /* Logo — sahifadagi eng muhim havola, uni bosish oson bo'lsin */
    padding: 4px;
    margin: -4px;
    border-radius: var(--r-sm);
  }

  .logo__mark {
    width: auto;
    /* Belgining o'zida nur bor, shuning uchun qo'shimcha soya kerak emas */
    filter: drop-shadow(0 2px 12px rgba(var(--brand-rgb), 0.45));
  }

  .logo__word {
    font-family: var(--font-display);
    font-size: 1.22rem;
    font-weight: 700;
    letter-spacing: -0.045em;
    color: var(--text);
    /* Logotip matni hech qachon o'ralmasin */
    white-space: nowrap;
  }
</style>
