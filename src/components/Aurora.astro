---
/**
 * Fon bezagi — «aurora»: ikkita rangli bulut + juda nozik to'r.
 *
 * DIZAYN QARORI: fon rasm EMAS, sof CSS. Sabab — 1600px kenglikdagi fon
 * rasmi WebP'da ham ~120 KB va u LCP dan oldin yuklanishi kerak. Radial
 * gradient esa 0 bayt tarmoq, GPU'da chiziladi va istalgan ekranda aniq
 * qoladi.
 *
 * Harakat juda sekin (40 s) va `prefers-reduced-motion` da to'liq to'xtaydi.
 */
---

<div class="aurora" aria-hidden="true">
  <span class="aurora__blob aurora__blob--1"></span>
  <span class="aurora__blob aurora__blob--2"></span>
  <span class="aurora__grid"></span>
</div>

<style>
  .aurora {
    position: fixed;
    inset: 0;
    z-index: var(--z-decor);
    pointer-events: none;
    overflow: hidden;
    /* Fon butun ekranni egallaydi, lekin hech qachon skroll yaratmaydi */
    contain: strict;
  }

  .aurora__blob {
    position: absolute;
    border-radius: 50%;
    /* `filter: blur()` katta radiusda qimmat — gradientning o'zi allaqachon
       yumshoq, shuning uchun blur ishlatilmaydi. */
    opacity: 0.5;
  }

  .aurora__blob--1 {
    top: -22vh;
    left: -8vw;
    width: min(78vw, 900px);
    aspect-ratio: 1;
    background: radial-gradient(circle, rgba(var(--brand-rgb), 0.42) 0%, rgba(var(--brand-rgb), 0) 66%);
  }

  .aurora__blob--2 {
    top: 24vh;
    right: -18vw;
    width: min(70vw, 820px);
    aspect-ratio: 1;
    background: radial-gradient(circle, rgba(var(--accent-rgb), 0.3) 0%, rgba(var(--accent-rgb), 0) 68%);
  }

  /* Nozik to'r — «texnologik» tuyg'u beradi va yassi fonda o'lcham hissi
     yaratadi. Chekkalarga qarab so'nadi, aks holda gorizont chizig'i bo'lib
     ko'zga tashlanadi. */
  .aurora__grid {
    position: absolute;
    inset: 0;
    background-image:
      linear-gradient(rgba(255, 255, 255, 0.028) 1px, transparent 1px),
      linear-gradient(90deg, rgba(255, 255, 255, 0.028) 1px, transparent 1px);
    background-size: 64px 64px;
    -webkit-mask-image: radial-gradient(ellipse 100% 62% at 50% 26%, #000 20%, transparent 78%);
    mask-image: radial-gradient(ellipse 100% 62% at 50% 26%, #000 20%, transparent 78%);
  }

  @media (prefers-reduced-motion: no-preference) {
    .aurora__blob--1 {
      animation: drift-a 44s var(--ease-in-out) infinite alternate;
    }
    .aurora__blob--2 {
      animation: drift-b 52s var(--ease-in-out) infinite alternate;
    }
  }

  @keyframes drift-a {
    to {
      transform: translate3d(7vw, 5vh, 0) scale(1.12);
    }
  }
  @keyframes drift-b {
    to {
      transform: translate3d(-6vw, -4vh, 0) scale(1.08);
    }
  }
</style>
