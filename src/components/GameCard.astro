---
/**
 * Katalog kartochkasi.
 *
 * KONSEPT: muqova — interfeysning O'ZI. O'yinchi o'z o'yinini rasm bo'yicha
 * bir qarashda taniydi, matnni o'qib o'tirmaydi. Shuning uchun rasm butun
 * kartochkani egallaydi, matn esa ustidagi parda ichida turadi.
 *
 * Kartochka BUTUNLIGICHA havola — mobil ekranda «tegish nishoni» kichkina
 * tugmadan ancha katta bo'ladi.
 */
import { Image } from "astro:assets";
import Icon from "./Icon.astro";
import { gameImage } from "../lib/gameImages";
import { etaText, type Game } from "../data/games";
import { localePath, type Locale } from "../data/site";
import { t, fill } from "../i18n/ui";

interface Props {
  game: Game;
  locale: Locale;
  /** Katakdagi o'rni — ko'rinish animatsiyasi navbat bilan ishlashi uchun */
  index?: number;
  /** Birinchi qator LCP nishoni bo'lishi mumkin — ular darhol yuklanadi */
  eager?: boolean;
}

const { game, locale, index = 0, eager = false } = Astro.props;
const c = t(locale);
const img = gameImage(game.slug);
const href = localePath(locale, `oyinlar/${game.slug}`);
const unit = game.unit[locale];
---

<a
  class:list={["gcard", game.lightArtwork && "is-light"]}
  href={href}
  style={`--a:${game.accent};--a2:${game.accent2};--d:${index * 45}ms`}
>
  {
    img && (
      <Image
        src={img}
        alt={`${game.title} — ${unit}`}
        width={280}
        height={280}
        densities={[1, 1.5]}
        loading={eager ? "eager" : "lazy"}
        fetchpriority={eager ? "high" : "auto"}
        class="gcard__art"
      />
    )
  }

  {/* Parda butun rasm ustida — matn har qanday muqovada o'qiladi */}
  <span class="gcard__scrim"></span>

  {game.popular && <span class="gcard__flag">{c.games.popular}</span>}

  <span class="gcard__eta">
    <Icon name="zap" size={11} />
    {etaText(game.etaMinutes, locale)}
  </span>

  <span class="gcard__body">
    <span class="gcard__unit">{fill(c.games.topupOf, { unit })}</span>
    <span class="gcard__name">{game.title}</span>
  </span>
</a>

<style>
  .gcard {
    position: relative;
    display: block;
    aspect-ratio: 3 / 4;
    border-radius: var(--r-lg);
    overflow: hidden;
    border: 1px solid var(--line);
    background: var(--surface-solid);
    isolation: isolate;
    transition:
      transform var(--dur) var(--ease),
      border-color var(--dur) var(--ease),
      box-shadow var(--dur) var(--ease);
  }

  .gcard:hover {
    transform: translateY(-5px);
    border-color: color-mix(in srgb, var(--a) 55%, transparent);
    box-shadow: 0 22px 54px -22px var(--a);
  }

  /* `color-mix` eski WebView'da yo'q — u yerda oddiy oq chegara qoladi */
  @supports not (color: color-mix(in srgb, red 50%, blue)) {
    .gcard:hover {
      border-color: var(--line-strong);
    }
  }

  .gcard__art {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    z-index: -2;
    transition: transform var(--dur-slow) var(--ease);
  }

  .gcard:hover .gcard__art {
    transform: scale(1.06);
  }

  /* Oq/och muqova (MLBB, Asphalt, Bigo, Steam): kesish o'rniga to'liq
     ko'rsatiladi, orqasiga esa o'yin rangidagi to'q plita qo'yiladi. */
  .gcard.is-light .gcard__art {
    object-fit: contain;
    padding: 16% 16% 34%;
    background: radial-gradient(circle at 50% 34%, color-mix(in srgb, var(--a) 26%, #0b0f1c), #080b15 72%);
  }

  @supports not (color: color-mix(in srgb, red 50%, blue)) {
    .gcard.is-light .gcard__art {
      background: #0b0f1c;
    }
  }

  .gcard__scrim {
    position: absolute;
    inset: 0;
    z-index: -1;
    background: linear-gradient(
      to top,
      rgba(4, 6, 13, 0.96) 0%,
      rgba(4, 6, 13, 0.72) 28%,
      rgba(4, 6, 13, 0.1) 58%,
      rgba(4, 6, 13, 0.28) 100%
    );
  }

  .gcard__flag,
  .gcard__eta {
    position: absolute;
    top: 10px;
    display: inline-flex;
    align-items: center;
    gap: 4px;
    padding: 5px 10px;
    border-radius: var(--r-pill);
    font-size: 0.6875rem;
    font-weight: 700;
    line-height: 1;
    backdrop-filter: blur(8px);
    -webkit-backdrop-filter: blur(8px);
  }

  .gcard__flag {
    inset-inline-start: 10px;
    background: var(--a);
    color: #0a0a0a;
  }

  .gcard__eta {
    inset-inline-end: 10px;
    background: rgba(4, 6, 13, 0.62);
    border: 1px solid rgba(255, 255, 255, 0.14);
    color: #fff;
  }

  .gcard__eta :global(svg) {
    color: var(--a);
  }

  .gcard__body {
    position: absolute;
    inset-inline: 0;
    bottom: 0;
    display: flex;
    flex-direction: column;
    gap: 3px;
    padding: 14px;
  }

  .gcard__unit {
    font-size: 0.6875rem;
    font-weight: 700;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--a);
  }

  .gcard__name {
    font-family: var(--font-display);
    font-size: 0.9375rem;
    font-weight: 700;
    letter-spacing: -0.025em;
    line-height: 1.2;
    color: #fff;
    /* Uzun nomlar («Call of Duty: Mobile») ikki qatorda to'liq ko'rinsin,
       uchinchi qator bo'lsa kesiladi */
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
</style>
