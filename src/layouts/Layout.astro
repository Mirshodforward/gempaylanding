---
/**
 * Sayt qobig'i — `<head>` dagi BARCHA SEO/AEO signallari shu yerda.
 *
 * Har sahifa faqat ma'lumot beradi (sarlavha, tavsif, JSON-LD tugunlari),
 * teglarni qanday chizishni esa faqat shu fayl biladi. Shu tufayli
 * canonical/hreflang/OG hech qayerda unutilib qolmaydi.
 */
import {
  SITE_URL,
  ORG,
  LOCALE_TAG,
  LOCALE_OG,
  LOCALES,
  VERIFICATION,
  absoluteUrl,
  localePath,
  type Locale,
} from "../data/site";
import { alternatesFor, type Alternate } from "../lib/seo";
import "../styles/app.css";

interface Props {
  locale: Locale;
  /** `<title>` — kalit so'z oldinda, ≤60 belgi */
  title: string;
  description: string;
  /** Tilsiz yo'l: `""`, `"oyinlar/pubg-mobile"`, `"blog/..."` */
  path: string;
  /** OG rasm — `/og/...` dan. Berilmasa umumiy rasm. */
  image?: string;
  keywords?: string[];
  /** Tarjimasi bor tillar. Blog maqolasi hamma tilda bo'lmasligi mumkin. */
  availableLocales?: readonly Locale[];
  /** `true` bo'lsa sahifa indekslanmaydi (tarjimasiz dublikatlar uchun) */
  noindex?: boolean;
  /** `og:type` — maqolalarda `article` */
  ogType?: "website" | "article";
  /** `graph(...)` natijasi — sahifa sxemalari */
  schema?: object | null;
  /** `<body>` ga qo'shimcha sinf (masalan o'yin aksenti uchun) */
  bodyClass?: string;
  /** Sahifa aksentini almashtirish — o'yin sahifalarida */
  accent?: { color: string; rgb: string; color2: string };
}

const {
  locale,
  title,
  description,
  path,
  image = "/og/default.png",
  keywords = [],
  availableLocales = LOCALES,
  noindex = false,
  ogType = "website",
  schema = null,
  bodyClass = "",
  accent,
} = Astro.props;

// Canonical va hreflang AYNAN bir manbadan (`localePath` + `absoluteUrl`)
// yasaladi — qo'lda yig'ilgan satr ertami-kechmi ulardan biri bilan
// farq qilib qolardi va hreflang klasteri buzilardi.
const canonical = absoluteUrl(localePath(locale, path));
const alternates: Alternate[] = alternatesFor(path, availableLocales);
const ogImage = absoluteUrl(image);

/** Sahifa aksentini `:root` ustidan qayta yozadi — tokenlar shundan ergashadi. */
const accentStyle = accent
  ? `--accent:${accent.color};--accent-rgb:${accent.rgb};--accent-2:${accent.color2};`
  : undefined;
---

<!doctype html>
<html lang={LOCALE_TAG[locale]} dir="ltr">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />

    <title>{title}</title>
    <meta name="description" content={description} />
    {keywords.length > 0 && <meta name="keywords" content={keywords.join(", ")} />}

    {/*
      `noindex` sahifada canonical ham, hreflang ham BERILMAYDI.

      404 sahifasining yo'li bo'sh, ya'ni canonical bosh sahifaga ishora
      qilardi — bu Google'ga «404 aslida bosh sahifa» degan signal beradi va
      indeksdagi bosh sahifani buzishi mumkin. Indekslanmaydigan sahifa uchun
      kanonik ko'rsatgichning ma'nosi ham yo'q.
    */}
    {!noindex && <link rel="canonical" href={canonical} />}

    {/* hreflang — har til o'zini VA barcha qardoshlarini ko'rsatishi shart,
        aks holda Google juftlikni «tasdiqlanmagan» deb tashlab yuboradi. */}
    {!noindex && alternates.map((a) => <link rel="alternate" hreflang={a.hreflang} href={a.href} />)}
    <link rel="alternate" type="application/rss+xml" title={`${ORG.name} — blog`} href={absoluteUrl("/rss.xml")} />

    {/* `max-image-preview:large` — Google Discover'da katta rasm huquqi;
        `max-snippet:-1` — javob mashinalari uzun iqtibos ola olishi uchun. */}
    <meta
      name="robots"
      content={noindex ? "noindex, follow" : "index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1"}
    />

    {/* ------------------------------------------------------- Open Graph -- */}
    <meta property="og:type" content={ogType} />
    <meta property="og:site_name" content={ORG.name} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={title} />
    <meta property="og:locale" content={LOCALE_OG[locale]} />
    {LOCALES.filter((l) => l !== locale).map((l) => (
      <meta property="og:locale:alternate" content={LOCALE_OG[l]} />
    ))}

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />

    {/* ------------------------------------------------------------ PWA --- */}
    <link rel="icon" href="/favicon.ico" sizes="48x48" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png" />
    <link rel="icon" type="image/png" sizes="16x16" href="/favicon-16x16.png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <meta name="theme-color" content="#070A14" />
    <meta name="application-name" content={ORG.name} />
    <meta name="apple-mobile-web-app-title" content={ORG.name} />

    {/* --------------------------------------------------------- shrift --- */}
    {/* Faqat lotin subseti oldindan yuklanadi — u har sahifada, birinchi
        ekranda ishlatiladi. Kirill faqat RU sahifada kerak, uni brauzer
        `unicode-range` bo'yicha o'zi so'raydi. */}
    <link rel="preload" href="/fonts/unbounded-latin.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/manrope-latin.woff2" as="font" type="font/woff2" crossorigin />

    {/* --------------------------------------------------- tasdiqlashlar -- */}
    {VERIFICATION.google && <meta name="google-site-verification" content={VERIFICATION.google} />}
    {VERIFICATION.yandex && <meta name="yandex-verification" content={VERIFICATION.yandex} />}
    {VERIFICATION.bing && <meta name="msvalidate.01" content={VERIFICATION.bing} />}

    {/* -------------------------------------------------------- JSON-LD --- */}
    {schema && (
      <script
        type="application/ld+json"
        is:inline
        set:html={JSON.stringify(schema)}
      />
    )}

    <slot name="head" />
  </head>

  <body class={bodyClass} style={accentStyle}>
    <a class="skip-link" href="#main">Asosiy mazmunga o'tish</a>
    <slot />
  </body>
</html>
